<?xml version="1.0"?>
<launch>
    <!-- <include file="$(find limo_gazebo)/launch/apartment.launch"/> -->

    <param name="robot_description" command="$(find xacro)/xacro '$(find limo_description)/urdf/limo_four_diff.xacro'" />

    <arg name="x_pos" default="0.0"/>
    <arg name="y_pos" default="0.0"/>
    <arg name="z_pos" default="0.16"/>
    <arg name="yaw" default="0.0"/>

    <!-- Load the control parameters -->
    <rosparam file="$(find limo_gazebo)/config/limo_four_diff_control.yaml" command="load"/>
    <!-- gazebo_ros_control reads these from /gazebo_ros_control/pid_gains. -->
    
    <node name="spawn_limo_model" pkg="gazebo_ros" type="spawn_model" args="-x $(arg x_pos)
        -y $(arg y_pos)
        -z $(arg z_pos)
        -Y $(arg yaw)
        -unpause
        -urdf
        -param robot_description
        -model limo" />

    <!-- 只启动 joint_state_controller，不启动 diff_drive_controller -->
    <node name="controller_spawner"
      pkg="controller_manager"
      type="spawner"
      output="screen"
      args="limo_state_controller"/>

    <!-- velocity_smoother: 对 cmd_vel 施加加速度限制 -->
    <node pkg="yocs_velocity_smoother" type="velocity_smoother" name="velocity_smoother"
          output="screen">
        <rosparam file="$(find limo_gazebo)/config/velocity_smoother.yaml" command="load"/>
        <remap from="velocity_smoother/raw_cmd_vel"    to="/limo/cmd_vel"/>
        <remap from="velocity_smoother/smooth_cmd_vel" to="/limo/cmd_vel_smooth"/>
        <remap from="velocity_smoother/odometry"       to="/odom"/>
    </node>

    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />
    <!-- <node name="dummy_zero_cmd_vel" pkg="limo_gazebo" type="dummy_cmd_vel" /> -->
        <node pkg="robot_localization"
          type="ekf_localization_node"
          name="ekf_localization"
          clear_params="true"
          output="screen">

        <rosparam command="load"
                  file="$(find limo_gazebo)/config/ekf.yaml" />

    </node>
    
    <include file="$(find limo_control)/launch/control.launch"/>
</launch>
